@page "/paquetes"

<PageTitle>Paquetes — DomusNet</PageTitle>

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Header -->
    <div class="text-center mb-14 animate-fade-in-up">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-domus-text mb-4">
            Nuestros <span class="gradient-text">Paquetes</span>
        </h1>
        <p class="max-w-2xl mx-auto text-domus-text-secondary text-lg">
            Elige el plan que mejor se adapte a las necesidades de tu hogar. Todos incluyen instalación y soporte técnico.
        </p>
    </div>

    <!-- Plans Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

        <!-- Plan Económico -->
        <div class="domus-card flex flex-col animate-fade-in-up stagger-1">
            <div class="mb-6">
                <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-domus-cyan/10 text-domus-cyan uppercase tracking-wider">
                    Económico
                </span>
            </div>
            <h2 class="text-2xl font-bold text-domus-text mb-2">Plan Económico</h2>
            <div class="flex items-baseline gap-1 mb-6">
                <span class="text-4xl font-extrabold gradient-text">10/8</span>
                <span class="text-domus-text-secondary text-sm">Mbps</span>
            </div>
            <div class="flex items-baseline gap-1 mb-6">
                <span class="text-2xl font-extrabold gradient-text">₡22,000</span>
                <span class="text-domus-text-secondary text-sm">/mes</span>
            </div>
            <ul class="space-y-3 mb-8 flex-1">
                <li class="flex items-center gap-3 text-domus-text-secondary text-sm">
                    <svg class="w-5 h-5 text-domus-cyan flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    IVA 13% 1% cruz roja
                </li>
                
            </ul>
            <button class="btn-outline-domus w-full justify-center">
                Solicitar
            </button>
        </div>
        <!-- Plan Básico -->
        <div class="domus-card flex flex-col animate-fade-in-up stagger-1">
            <div class="mb-6">
                <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-domus-cyan/10 text-domus-cyan uppercase tracking-wider">
                    Básico
                </span>
            </div>
            <h2 class="text-2xl font-bold text-domus-text mb-2">Plan Básico</h2>
            <div class="flex items-baseline gap-1 mb-6">
                <span class="text-4xl font-extrabold gradient-text">15/10</span>
                <span class="text-domus-text-secondary text-sm">Mbps</span>
            </div>
            <div class="flex items-baseline gap-1 mb-6">
                <span class="text-2xl font-extrabold gradient-text">₡25,000</span>
                <span class="text-domus-text-secondary text-sm">/mes</span>
            </div>
            <ul class="space-y-3 mb-8 flex-1">
                <li class="flex items-center gap-3 text-domus-text-secondary text-sm">
                    <svg class="w-5 h-5 text-domus-cyan flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    IVA 13% 1% cruz roja
                </li>
                
            </ul>
            <button class="btn-outline-domus w-full justify-center">
                Solicitar
            </button>
        </div>

        <!-- Plan Regular -->
        <div class="domus-card flex flex-col animate-fade-in-up stagger-3">
            <div class="mb-6">
                <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-domus-cyan/10 text-domus-cyan uppercase tracking-wider">
                    Regular
                </span>
            </div>
            <h2 class="text-2xl font-bold text-domus-text mb-2">Plan Regular</h2>
            <div class="flex items-baseline gap-1 mb-6">
                <span class="text-4xl font-extrabold gradient-text">20/15</span>
                <span class="text-domus-text-secondary text-sm">Mbps</span>
            </div>
            <div class="flex items-baseline gap-1 mb-6">
                <span class="text-4xl font-extrabold gradient-text">₡29,900</span>
                <span class="text-domus-text-secondary text-sm">/mes</span>
            </div>
            <ul class="space-y-3 mb-8 flex-1">
                <li class="flex items-center gap-3 text-domus-text-secondary text-sm">
                    <svg class="w-5 h-5 text-domus-cyan flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    IVA 13% 1% cruz roja
                </li>
                
            </ul>
            <button class="btn-outline-domus w-full justify-center">
                Solicitar
            </button>
        </div>

        <!-- Plan Profesional (Destacado) -->
        <div class="domus-card flex flex-col relative border-domus-cyan/30 animate-pulse-glow animate-fade-in-up stagger-2">
            
            <div class="mb-6 mt-2">
                <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-domus-green/10 text-domus-green uppercase tracking-wider">
                    Profesional
                </span>
            </div>
            <h2 class="text-2xl font-bold text-domus-text mb-2">Plan Profesional</h2>
            <div class="flex items-baseline gap-1 mb-6">
                <span class="text-4xl font-extrabold gradient-text">30/20</span>
                <span class="text-domus-text-secondary text-sm">Mbps</span>
            </div>
            <div class="flex items-baseline gap-1 mb-6">
                <span class="text-4xl font-extrabold gradient-text">₡41,000</span>
                <span class="text-domus-text-secondary text-sm">/mes</span>
            </div>
            <ul class="space-y-3 mb-8 flex-1">
                <li class="flex items-center gap-3 text-domus-text-secondary text-sm">
                    <svg class="w-5 h-5 text-domus-green flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    IVA 13% 1% cruz roja
                </li>
                
            </ul>
            <button class="btn-primary-domus w-full justify-center">
                Solicitar
            </button>
        </div>

        

    </div>
</section>

