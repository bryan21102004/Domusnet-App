@page "/paquetes"
@using DomusNet.Blazor.Models
@using DomusNet.Blazor.Services
@inject PaquetesFrontendService PaquetesService
@inject NavigationManager Navigation

<PageTitle>Paquetes — DomusNet</PageTitle>

<section class="min-h-[calc(100vh-4rem)] px-4 sm:px-6 lg:px-8 py-16">
    <div class="max-w-7xl mx-auto">

        <!-- Header -->
        <div class="text-center mb-16">
            <h1 class="text-4xl sm:text-5xl font-extrabold text-domus-text">
                Nuestros <span class="gradient-text">Paquetes</span>
            </h1>

            <p class="text-domus-text-secondary text-lg mt-6 max-w-2xl mx-auto">
                Elegí el plan que mejor se adapte a las necesidades de tu hogar.
                Todos incluyen instalación y soporte técnico.
            </p>
        </div>

        @if (cargando)
        {
            <div class="domus-card text-center py-12">
                <p class="text-domus-text-secondary">
                    Cargando paquetes disponibles...
                </p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(mensajeError))
        {
            <div class="p-4 rounded-lg border border-red-500/40 bg-red-500/10 text-red-300 text-center">
                @mensajeError
            </div>
        }
        else if (!paquetes.Any())
        {
            <div class="domus-card text-center py-12">
                <h2 class="text-2xl font-bold text-domus-text mb-2">
                    No hay paquetes disponibles
                </h2>
                <p class="text-domus-text-secondary">
                    Actualmente no hay paquetes activos para mostrar.
                </p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
                @foreach (var paquete in paquetes)
                {
                    <div class="domus-card flex flex-col justify-between hover:border-cyan-500/40 transition-all duration-300">

                        <div>
                            <div class="mb-8">
                                <span class="inline-flex text-xs px-3 py-1 rounded-full bg-cyan-500/10 text-domus-cyan-light font-bold tracking-wide">
                                    @ObtenerEtiqueta(paquete)
                                </span>
                            </div>

                            <h2 class="text-2xl font-bold text-domus-text mb-6">
                                @paquete.Nombre
                            </h2>

                            <div class="mb-8">
                                <p class="text-5xl font-extrabold gradient-text">
                                    @paquete.Velocidad
                                    <span class="text-base font-medium text-domus-text-secondary">
                                        Mbps
                                    </span>
                                </p>
                            </div>

                            <div class="mb-8">
                                <p class="text-4xl font-extrabold text-domus-cyan-light">
                                    ₡@paquete.Precio.ToString("N0")
                                    <span class="text-base font-medium text-domus-text-secondary">
                                        /mes
                                    </span>
                                </p>
                            </div>

                            <div class="space-y-3 mb-10">
                                <div class="flex items-center gap-3 text-domus-text-secondary">
                                    <span class="text-domus-cyan-light text-xl">✓</span>
                                    <span>IVA 13% 1% cruz roja</span>
                                </div>

                                <div class="flex items-center gap-3 text-domus-text-secondary">
                                    <span class="text-domus-cyan-light text-xl">✓</span>
                                    <span>Soporte técnico incluido</span>
                                </div>

                                <div class="flex items-center gap-3 text-domus-text-secondary">
                                    <span class="text-domus-cyan-light text-xl">✓</span>
                                    <span>Instalación residencial</span>
                                </div>
                            </div>
                        </div>

                        <button class="w-full px-5 py-3 rounded-lg border border-domus-cyan text-domus-cyan-light font-semibold hover:bg-domus-cyan hover:text-domus-dark transition-colors"
                                @onclick="() => SolicitarPaquete(paquete.IdPaquete)">
                            Solicitar
                        </button>
                    </div>
                }
            </div>
        }

    </div>
</section>

@code {
    private List<PaqueteResponse> paquetes = new();
    private bool cargando = true;
    private string mensajeError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarPaquetes();
    }

    private async Task CargarPaquetes()
    {
        cargando = true;
        mensajeError = string.Empty;

        try
        {
            paquetes = await PaquetesService.ListarActivosAsync();

            paquetes = paquetes
                .OrderBy(p => p.IdPaquete)
                .ToList();
        }
        catch
        {
            mensajeError = "No se pudieron cargar los paquetes. Verifique que la API esté activa.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void SolicitarPaquete(int idPaquete)
    {
        Navigation.NavigateTo($"/solicitar-paquete/{idPaquete}");
    }

    private string ObtenerEtiqueta(PaqueteResponse paquete)
    {
        if (!string.IsNullOrWhiteSpace(paquete.Descripcion))
        {
            return paquete.Descripcion
                .Replace("Internet", "")
                .Trim()
                .ToUpper();
        }

        return paquete.Nombre
            .Replace("Plan", "")
            .Trim()
            .ToUpper();
    }
}