@page "/"

<PageTitle>DomusNet — Internet para tu hogar</PageTitle>

<!-- Hero Section -->
<section class="relative overflow-hidden">
    <!-- Background gradient effect -->
    <div class="absolute inset-0 bg-gradient-to-b from-domus-dark via-domus-dark to-domus-darker"></div>
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-domus-cyan/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-domus-green/5 rounded-full blur-3xl"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28 lg:py-36">
        <div class="flex flex-col items-center text-center">

            <!-- Logo -->
            <div class="mb-6 animate-fade-in-up">
                <img src="images/logo-domusnet.png" alt="DomusNet Logo"
                     class="w-80 sm:w-[32rem] lg:w-[40rem] h-auto drop-shadow-2xl" />
            </div>


            <!-- Tagline -->
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-domus-text mb-6 animate-fade-in-up stagger-1">
                Internet de <span class="gradient-text">alta velocidad</span><br />
                para tu hogar
            </h1>

            <p class="max-w-2xl text-lg sm:text-xl text-domus-text-secondary mb-10 animate-fade-in-up stagger-2">
                Conectamos tu hogar o negocio con internet estable, rápido y confiable, incluso en zonas donde otras 
                compañias no tienen cobertura.
            </p>

            <!-- CTA Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 animate-fade-in-up stagger-3">
                <a href="paquetes" class="btn-primary-domus text-base px-8 py-3">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21" />
                    </svg>
                    Ver Paquetes
                </a>
                <a href="contacto" class="btn-outline-domus text-base px-8 py-3">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                    </svg>
                    Contáctanos
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="relative py-20 bg-domus-darker/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

            <!-- Feature 1 -->
            <div class="domus-card text-center animate-fade-in-up stagger-1">
                <div class="w-14 h-14 mx-auto mb-4 rounded-xl bg-gradient-to-br from-cyan-500/20 to-cyan-500/5 flex items-center justify-center">
                    <svg class="w-7 h-7 text-domus-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-domus-text mb-2">Instalación Rápida</h3>
                <p class="text-domus-text-secondary text-sm leading-relaxed">
                    Para que disfrutes de internet de alta velocidad en poco tiempo.
                </p>
            </div>

            <!-- Feature 2 -->
            <div class="domus-card text-center animate-fade-in-up stagger-2">
                <div class="w-14 h-14 mx-auto mb-4 rounded-xl bg-gradient-to-br from-emerald-500/20 to-emerald-500/5 flex items-center justify-center">
                    <svg class="w-7 h-7 text-domus-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-domus-text mb-2">Conexión Estable</h3>
                <p class="text-domus-text-secondary text-sm leading-relaxed">
                    Estable y confiable para que disfrutes de internet en todo momento.
                </p>
            </div>

            <!-- Feature 3 -->
            <div class="domus-card text-center animate-fade-in-up stagger-3">
                <div class="w-14 h-14 mx-auto mb-4 rounded-xl bg-gradient-to-br from-cyan-500/20 to-emerald-500/5 flex items-center justify-center">
                    <svg class="w-7 h-7 text-domus-cyan-light" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.1-5.1m0 0L12 4.37m-5.68 5.7h15.36m-4.1 5.1l5.1-5.1m0 0L17.32 4.37m5.68 5.7H7.64" />
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-domus-text mb-2">Soporte 24/7</h3>
                <p class="text-domus-text-secondary text-sm leading-relaxed">
                    Equipo técnico disponible las 24 horas para resolver cualquier inconveniente al instante,
                    mediante correosoporte@domustechs.com
                </p>
            </div>

        </div>
    </div>
</section>