@page "/reportar-averia"
@using DomusNet.Blazor.Models
@using DomusNet.Blazor.Services
@inject TicketsFrontendService TicketsService
@inject ToastService Toast

<PageTitle>Reportar Avería — DomusNet</PageTitle>

<section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-10 animate-fade-in-up">
        <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-gradient-to-br from-amber-500/20 to-amber-500/5 flex items-center justify-center">
            <svg class="w-8 h-8 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-domus-text mb-3">
            Reportar <span class="gradient-text">Avería</span>
        </h1>
        <p class="text-domus-text-secondary">
            Solo clientes con servicio activo pueden reportar averías. Verificá tu teléfono registrado en DomusNet.
        </p>
    </div>

    <div class="domus-card animate-fade-in-up stagger-1">
        <form class="space-y-5" @onsubmit="EnviarReporte" @onsubmit:preventDefault="true">
            <div>
                <label class="block text-sm font-medium text-domus-text mb-1.5">Teléfono registrado</label>
                <div class="flex flex-col sm:flex-row gap-3">
                    <input type="tel" placeholder="El teléfono de tu servicio DomusNet"
                           @bind="reporte.Telefono"
                           @bind:after="ReiniciarVerificacion"
                           class="flex-1 px-4 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text placeholder-domus-text-secondary/50 focus:outline-none focus:border-domus-cyan focus:ring-1 focus:ring-domus-cyan/30 transition-colors" />
                    <button type="button"
                            disabled="@verificando"
                            @onclick="VerificarTelefono"
                            class="px-5 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text hover:border-cyan-500/50 transition-colors disabled:opacity-60">
                        @(verificando ? "Verificando..." : "Verificar")
                    </button>
                </div>
                <p class="text-xs text-domus-text-secondary mt-2">
                    Debe coincidir con el teléfono del cliente activo en nuestro sistema.
                </p>
            </div>

            @if (clienteVerificado)
            {
                <div class="p-4 rounded-lg border border-emerald-500/30 bg-emerald-500/10 text-emerald-300 text-sm">
                    Cliente verificado. Podés continuar con el reporte de avería.
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(mensajeVerificacion))
            {
                <div class="p-4 rounded-lg border border-red-500/30 bg-red-500/10 text-red-300 text-sm">
                    @mensajeVerificacion
                </div>
            }

            <div>
                <label class="block text-sm font-medium text-domus-text mb-1.5">Nombre completo</label>
                <input type="text" placeholder="Se completará al verificar el teléfono"
                       @bind="reporte.NombreCompleto"
                       readonly="@clienteVerificado"
                       class="w-full px-4 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text placeholder-domus-text-secondary/50 focus:outline-none focus:border-domus-cyan focus:ring-1 focus:ring-domus-cyan/30 transition-colors @(clienteVerificado ? "opacity-80" : "")" />
            </div>
            <div>
                <label class="block text-sm font-medium text-domus-text mb-1.5">Dirección</label>
                <input type="text" placeholder="Se completará al verificar el teléfono"
                       @bind="reporte.Direccion"
                       readonly="@clienteVerificado"
                       class="w-full px-4 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text placeholder-domus-text-secondary/50 focus:outline-none focus:border-domus-cyan focus:ring-1 focus:ring-domus-cyan/30 transition-colors @(clienteVerificado ? "opacity-80" : "")" />
            </div>
            <div>
                <label class="block text-sm font-medium text-domus-text mb-1.5">Descripción del problema</label>
                <textarea rows="4" placeholder="Describe la avería o problema..."
                          @bind="reporte.DescripcionProblema"
                          disabled="@(!clienteVerificado)"
                          class="w-full px-4 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text placeholder-domus-text-secondary/50 focus:outline-none focus:border-domus-cyan focus:ring-1 focus:ring-domus-cyan/30 transition-colors resize-none disabled:opacity-60"></textarea>
            </div>

            <button type="submit"
                    disabled="@(enviando || !clienteVerificado)"
                    class="btn-primary-domus w-full justify-center py-3 text-base mt-2 disabled:opacity-60 disabled:cursor-not-allowed">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                </svg>
                @(enviando ? "Enviando..." : "Enviar Reporte")
            </button>
        </form>
    </div>
</section>

@code {
    private ReportarAveriaRequest reporte = new();
    private bool enviando = false;
    private bool verificando = false;
    private bool clienteVerificado = false;
    private string mensajeVerificacion = string.Empty;

    private void ReiniciarVerificacion()
    {
        clienteVerificado = false;
        mensajeVerificacion = string.Empty;
        reporte.NombreCompleto = string.Empty;
        reporte.Direccion = string.Empty;
    }

    private async Task VerificarTelefono()
    {
        mensajeVerificacion = string.Empty;

        if (string.IsNullOrWhiteSpace(reporte.Telefono))
        {
            Toast.Warning("Debe ingresar su teléfono registrado.");
            return;
        }

        verificando = true;

        try
        {
            var cliente = await TicketsService.VerificarClienteAsync(reporte.Telefono);

            if (cliente == null)
            {
                clienteVerificado = false;
                reporte.NombreCompleto = string.Empty;
                reporte.Direccion = string.Empty;
                mensajeVerificacion = "No se encontró un cliente activo con ese teléfono. Solo clientes con servicio instalado pueden reportar averías.";
                return;
            }

            clienteVerificado = true;
            reporte.NombreCompleto = cliente.NombreCompleto;
            reporte.Direccion = cliente.Direccion;
            Toast.Success("Teléfono verificado correctamente.");
        }
        catch
        {
            clienteVerificado = false;
            mensajeVerificacion = "No se pudo verificar el teléfono. Verifique que la API esté activa.";
        }
        finally
        {
            verificando = false;
        }
    }

    private async Task EnviarReporte()
    {
        if (!clienteVerificado)
        {
            Toast.Warning("Debe verificar su teléfono antes de enviar el reporte.");
            return;
        }

        if (string.IsNullOrWhiteSpace(reporte.DescripcionProblema))
        {
            Toast.Warning("Debe describir el problema.");
            return;
        }

        enviando = true;

        try
        {
            var resultado = await TicketsService.ReportarAveriaAsync(reporte);

            if (!resultado.Exitoso)
            {
                Toast.Error(resultado.Mensaje ?? "No se pudo registrar el reporte.");
                return;
            }

            Toast.Success(resultado.Mensaje ?? "Reporte de avería creado correctamente.");
            reporte = new ReportarAveriaRequest();
            clienteVerificado = false;
            mensajeVerificacion = string.Empty;
        }
        catch
        {
            Toast.Error("No se pudo enviar el reporte.");
        }
        finally
        {
            enviando = false;
        }
    }
}
