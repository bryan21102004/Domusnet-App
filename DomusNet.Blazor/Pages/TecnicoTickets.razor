@page "/tecnico/tickets"
@using DomusNet.Blazor.Models
@using DomusNet.Blazor.Services
@using Microsoft.JSInterop
@inject TicketsFrontendService TicketsService
@inject AuthFrontendService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Tickets y averías — Técnico</PageTitle>

<section class="min-h-[calc(100vh-4rem)] px-4 sm:px-6 lg:px-8 py-8">
    <div class="max-w-7xl mx-auto">

        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4 mb-8">
            <div>
                <p class="text-sm text-domus-cyan-light font-semibold mb-2">Panel técnico</p>
                <h1 class="text-3xl sm:text-4xl font-extrabold text-domus-text">
                    Tickets y <span class="gradient-text">Averías</span>
                </h1>
                <p class="text-domus-text-secondary mt-2">
                    Atendé reportes de clientes y averías globales del servicio.
                </p>
            </div>

            <div class="flex flex-wrap gap-3">
                <button class="px-5 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text hover:border-cyan-500/50 transition-colors"
                        @onclick="VolverPanel">
                    Volver
                </button>
                <button class="px-5 py-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-300 hover:border-red-500/50 transition-colors"
                        @onclick="() => mostrarFormularioGlobal = !mostrarFormularioGlobal">
                    @(mostrarFormularioGlobal ? "Cancelar" : "Nueva avería global")
                </button>
                <button class="btn-primary-domus px-5 py-3" @onclick="CargarTickets">
                    Actualizar
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="@claseMensaje mb-6">@mensaje</div>
        }

        @if (mostrarFormularioGlobal)
        {
            <div class="domus-card mb-6 border-red-500/30">
                <h2 class="text-xl font-bold text-domus-text mb-4">Registrar avería global</h2>
                <p class="text-sm text-domus-text-secondary mb-5">
                    Esta avería quedará visible para todos los clientes mientras esté activa.
                </p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium text-domus-text mb-1.5">Título</label>
                        <input class="w-full px-4 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text"
                               @bind="nuevoGlobal.Titulo" placeholder="Ej: Caída de servicio en la zona" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium text-domus-text mb-1.5">Descripción</label>
                        <textarea rows="3"
                                  class="w-full px-4 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text resize-none"
                                  @bind="nuevoGlobal.Descripcion"
                                  placeholder="Detalle de la avería..."></textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-domus-text mb-1.5">Prioridad</label>
                        <select class="w-full px-4 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text"
                                @bind="nuevoGlobal.Prioridad">
                            <option value="Alta">Alta</option>
                            <option value="Media">Media</option>
                            <option value="Baja">Baja</option>
                        </select>
                    </div>
                </div>

                <button class="btn-primary-domus" disabled="@guardandoGlobal" @onclick="CrearAveriaGlobal">
                    @(guardandoGlobal ? "Guardando..." : "Publicar avería global")
                </button>
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-6">
            <div class="domus-card">
                <p class="text-sm text-domus-text-secondary">Pendientes</p>
                <p class="text-3xl font-extrabold text-yellow-300 mt-2">@ContarPorEstado("Pendiente")</p>
            </div>
            <div class="domus-card">
                <p class="text-sm text-domus-text-secondary">En proceso</p>
                <p class="text-3xl font-extrabold text-cyan-300 mt-2">@ContarPorEstado("EnProceso")</p>
            </div>
            <div class="domus-card">
                <p class="text-sm text-domus-text-secondary">Globales activas</p>
                <p class="text-3xl font-extrabold text-red-300 mt-2">@tickets.Count(t => t.EsGlobal && t.Estado != "Resuelto")</p>
            </div>
        </div>

        <div class="domus-card mb-6">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                <div>
                    <h2 class="text-xl font-bold text-domus-text">Tickets asignados y reportes</h2>
                    <p class="text-sm text-domus-text-secondary mt-1">Mostrando: @ticketsFiltrados.Count</p>
                </div>
                <div class="flex flex-col sm:flex-row gap-3">
                    <select class="px-4 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text"
                            @bind="estadoFiltro">
                        <option value="">Todos los estados</option>
                        <option value="Pendiente">Pendientes</option>
                        <option value="EnProceso">En proceso</option>
                        <option value="Resuelto">Resueltos</option>
                    </select>
                    <input class="px-4 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text"
                           placeholder="Buscar..."
                           @bind="busqueda" />
                </div>
            </div>
        </div>

        @if (cargando)
        {
            <div class="domus-card text-center py-12">
                <p class="text-domus-text-secondary">Cargando tickets...</p>
            </div>
        }
        else if (!ticketsFiltrados.Any())
        {
            <div class="domus-card text-center py-12">
                <h3 class="text-xl font-bold text-domus-text mb-2">No hay tickets para mostrar</h3>
                <p class="text-domus-text-secondary">Cuando un cliente reporte una avería, aparecerá aquí.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 gap-5">
                @foreach (var ticket in ticketsFiltrados)
                {
                    <div class="domus-card hover:border-cyan-500/30 transition-all duration-300">
                        <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-5">
                            <div class="flex-1">
                                <div class="flex flex-wrap items-center gap-3 mb-3">
                                    <span class="text-xs px-3 py-1 rounded-full border @ObtenerClaseEstado(ticket.Estado)">
                                        @ticket.Estado
                                    </span>
                                    @if (ticket.EsGlobal)
                                    {
                                        <span class="text-xs px-3 py-1 rounded-full bg-red-500/10 text-red-300 border border-red-500/30">
                                            Global
                                        </span>
                                    }
                                    <span class="text-xs text-domus-text-secondary">Ticket #@ticket.IdTicket</span>
                                </div>

                                <h2 class="text-xl font-bold text-domus-text mb-2">@ticket.Titulo</h2>

                                @if (!string.IsNullOrWhiteSpace(ticket.Descripcion))
                                {
                                    <p class="text-sm text-domus-text-secondary whitespace-pre-line mb-4">@ticket.Descripcion</p>
                                }

                                @if (ticketExpandidoId == ticket.IdTicket && historial.Any())
                                {
                                    <div class="mt-4 p-4 rounded-lg bg-domus-dark border border-domus-border">
                                        <h3 class="text-sm font-semibold text-domus-text mb-3">Historial</h3>
                                        <div class="space-y-3">
                                            @foreach (var item in historial)
                                            {
                                                <div class="text-sm border-l-2 border-cyan-500/40 pl-3">
                                                    <p class="text-domus-text">@(item.EstadoAnterior ?? "Nuevo") → @item.EstadoNuevo</p>
                                                    <p class="text-domus-text-secondary">
                                                        @item.NombreUsuario · @item.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                                    </p>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="flex flex-col gap-3 lg:w-56">
                                <button class="px-4 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text hover:border-cyan-500/50 transition-colors"
                                        @onclick="() => VerHistorial(ticket.IdTicket)">
                                    @(ticketExpandidoId == ticket.IdTicket ? "Ocultar historial" : "Ver historial")
                                </button>

                                @if (ticket.Estado == "Pendiente")
                                {
                                    <button class="btn-primary-domus w-full justify-center"
                                            @onclick='() => CambiarEstado(ticket.IdTicket, "EnProceso")'>
                                        Atender
                                    </button>
                                }

                                @if (ticket.Estado == "EnProceso")
                                {
                                    <button class="px-4 py-3 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 hover:border-emerald-500/50 transition-colors"
                                            @onclick='() => CambiarEstado(ticket.IdTicket, "Resuelto")'>
                                        Marcar resuelto
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private List<TicketResponse> tickets = new();
    private List<HistorialTicketResponse> historial = new();

    private string busqueda = string.Empty;
    private string estadoFiltro = "Pendiente";
    private string mensaje = string.Empty;
    private string claseMensaje = string.Empty;

    private bool cargando = false;
    private bool guardandoGlobal = false;
    private bool mostrarFormularioGlobal = false;
    private int? ticketExpandidoId;

    private TicketCreateRequest nuevoGlobal = new()
    {
        Tipo = "Averia",
        Prioridad = "Alta",
        EsGlobal = true
    };

    private List<TicketResponse> ticketsFiltrados =>
        tickets
            .Where(t => string.IsNullOrWhiteSpace(estadoFiltro) ||
                        string.Equals(t.Estado, estadoFiltro, StringComparison.OrdinalIgnoreCase))
            .Where(t => string.IsNullOrWhiteSpace(busqueda) ||
                        (t.Titulo?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (t.Descripcion?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false))
            .OrderByDescending(t => t.FechaCreacion)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
        var rol = await JS.InvokeAsync<string>("localStorage.getItem", "rol");

        if (string.IsNullOrWhiteSpace(token))
        {
            Navigation.NavigateTo("/acceso-interno", forceLoad: true);
            return;
        }

        var rolNormalizado = rol?.Trim().ToLower();
        if (rolNormalizado != "tecnico" && rolNormalizado != "técnico")
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        await CargarTickets();
    }

    private async Task CargarTickets()
    {
        cargando = true;
        mensaje = string.Empty;

        try
        {
            tickets = await TicketsService.ListarTicketsAsync();
        }
        catch
        {
            MostrarError("No se pudieron cargar los tickets.");
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CrearAveriaGlobal()
    {
        if (string.IsNullOrWhiteSpace(nuevoGlobal.Titulo))
        {
            MostrarError("Debe ingresar un título para la avería global.");
            return;
        }

        var idUsuario = await AuthService.ObtenerUsuarioIdAsync();
        if (idUsuario <= 0)
        {
            MostrarError("No se pudo obtener el usuario autenticado.");
            return;
        }

        guardandoGlobal = true;

        try
        {
            nuevoGlobal.IdCreadoPor = idUsuario;
            nuevoGlobal.EsGlobal = true;
            nuevoGlobal.Tipo = "Averia";

            var resultado = await TicketsService.CrearTicketAsync(nuevoGlobal);

            if (resultado == null)
            {
                MostrarError("No se pudo crear la avería global.");
                return;
            }

            MostrarExito(resultado.Mensaje ?? "Avería global creada correctamente.");
            nuevoGlobal = new TicketCreateRequest { Tipo = "Averia", Prioridad = "Alta", EsGlobal = true };
            mostrarFormularioGlobal = false;
            await CargarTickets();
        }
        catch
        {
            MostrarError("Error al crear la avería global.");
        }
        finally
        {
            guardandoGlobal = false;
        }
    }

    private async Task VerHistorial(int idTicket)
    {
        if (ticketExpandidoId == idTicket)
        {
            ticketExpandidoId = null;
            historial = new();
            return;
        }

        ticketExpandidoId = idTicket;
        historial = await TicketsService.ObtenerHistorialAsync(idTicket);
    }

    private async Task CambiarEstado(int idTicket, string estadoNuevo)
    {
        var idUsuario = await AuthService.ObtenerUsuarioIdAsync();
        if (idUsuario <= 0)
        {
            MostrarError("No se pudo obtener el usuario autenticado.");
            return;
        }

        var request = new ActualizarEstadoTicketRequest
        {
            EstadoNuevo = estadoNuevo,
            IdUsuario = idUsuario,
            Comentario = estadoNuevo == "EnProceso"
                ? "Ticket tomado por el técnico."
                : "Ticket resuelto por el técnico."
        };

        var ok = await TicketsService.ActualizarEstadoAsync(idTicket, request);

        if (!ok)
        {
            MostrarError("No se pudo actualizar el estado del ticket.");
            return;
        }

        var ticket = tickets.FirstOrDefault(t => t.IdTicket == idTicket);
        if (ticket != null)
        {
            ticket.Estado = estadoNuevo;
        }

        if (ticketExpandidoId == idTicket)
        {
            historial = await TicketsService.ObtenerHistorialAsync(idTicket);
        }

        MostrarExito($"Ticket #{idTicket} actualizado a {estadoNuevo}.");
    }

    private int ContarPorEstado(string estado) =>
        tickets.Count(t => string.Equals(t.Estado, estado, StringComparison.OrdinalIgnoreCase));

    private void VolverPanel() => Navigation.NavigateTo("/tecnico");

    private void MostrarExito(string texto)
    {
        mensaje = texto;
        claseMensaje = "p-4 rounded-lg border border-emerald-500/40 bg-emerald-500/10 text-emerald-300";
    }

    private void MostrarError(string texto)
    {
        mensaje = texto;
        claseMensaje = "p-4 rounded-lg border border-red-500/40 bg-red-500/10 text-red-300";
    }

    private string ObtenerClaseEstado(string? estado) => estado?.Trim().ToLower() switch
    {
        "pendiente" => "bg-yellow-500/10 text-yellow-300 border-yellow-500/30",
        "enproceso" => "bg-cyan-500/10 text-cyan-300 border-cyan-500/30",
        "resuelto" => "bg-emerald-500/10 text-emerald-300 border-emerald-500/30",
        _ => "bg-white/5 text-domus-text-secondary border-domus-border"
    };
}
