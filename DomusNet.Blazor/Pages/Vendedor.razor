@page "/vendedor"
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Panel Vendedor — DomusNet</PageTitle>

<section class="min-h-[calc(100vh-4rem)] px-4 sm:px-6 lg:px-8 py-8">
    <div class="max-w-7xl mx-auto">

        <!-- Encabezado -->
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4 mb-8">
            <div>
                <p class="text-sm text-domus-cyan-light font-semibold mb-2">
                    Panel interno
                </p>

                <h1 class="text-3xl sm:text-4xl font-extrabold text-domus-text">
                    Gestión de <span class="gradient-text">Ventas</span>
                </h1>

                <p class="text-domus-text-secondary mt-2">
                    Bienvenido, @nombreUsuario
                </p>
            </div>
        </div>

        <!-- Módulos principales -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">

            <!-- Solicitudes -->
            <div class="domus-card group hover:border-cyan-500/50 transition-all duration-300">
                <div class="flex items-start justify-between mb-6">
                    <div class="w-12 h-12 rounded-xl bg-cyan-500/10 flex items-center justify-center">
                        <svg class="w-7 h-7 text-domus-cyan-light" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2.25 4.5H6.75A2.25 2.25 0 014.5 18.25V5.75A2.25 2.25 0 016.75 3.5h7.5L19.5 8.75v9.5a2.25 2.25 0 01-2.25 2.25z" />
                        </svg>
                    </div>

                    <span class="text-xs px-3 py-1 rounded-full bg-cyan-500/10 text-domus-cyan-light border border-cyan-500/20">
                        Solicitudes
                    </span>
                </div>

                <h2 class="text-2xl font-bold text-domus-text mb-2">
                    Solicitudes
                </h2>

                <p class="text-domus-text-secondary text-sm mb-6">
                    Gestionar solicitudes de servicio recibidas.
                </p>

                <button class="btn-primary-domus w-full justify-center" @onclick="IrSolicitudes">
                    Entrar
                </button>
            </div>

            <!-- Instalaciones -->
            <div class="domus-card group hover:border-emerald-500/50 transition-all duration-300">
                <div class="flex items-start justify-between mb-6">
                    <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center">
                        <svg class="w-7 h-7 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12M8.25 17.25h12M3.75 6.75h.008v.008H3.75V6.75zm0 5.25h.008v.008H3.75V12zm0 5.25h.008v.008H3.75v-.008z" />
                        </svg>
                    </div>

                    <span class="text-xs px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                        Programación
                    </span>
                </div>

                <h2 class="text-2xl font-bold text-domus-text mb-2">
                    Instalaciones
                </h2>

                <p class="text-domus-text-secondary text-sm mb-6">
                    Programar y consultar instalaciones asignadas.
                </p>

                <button class="btn-primary-domus w-full justify-center" @onclick="IrInstalaciones">
                    Entrar
                </button>
            </div>

            <!-- Clientes -->
            <div class="domus-card group hover:border-cyan-500/50 transition-all duration-300">
                <div class="flex items-start justify-between mb-6">
                    <div class="w-12 h-12 rounded-xl bg-cyan-500/10 flex items-center justify-center">
                        <svg class="w-7 h-7 text-domus-cyan-light" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128A9.37 9.37 0 0112 19.5c-2.291 0-4.39-.827-6.011-2.199A4.125 4.125 0 0112 15.375c.836 0 1.616.25 2.265.68M12 12a3.375 3.375 0 100-6.75A3.375 3.375 0 0012 12z" />
                        </svg>
                    </div>

                    <span class="text-xs px-3 py-1 rounded-full bg-cyan-500/10 text-domus-cyan-light border border-cyan-500/20">
                        Clientes
                    </span>
                </div>

                <h2 class="text-2xl font-bold text-domus-text mb-2">
                    Clientes
                </h2>

                <p class="text-domus-text-secondary text-sm mb-6">
                    Consultar clientes convertidos y activos.
                </p>

                <button class="btn-primary-domus w-full justify-center" @onclick="IrClientes">
                    Entrar
                </button>
            </div>

        </div>

    </div>
</section>

@code {
    private string nombreUsuario = "Vendedor";

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
        var rol = await JS.InvokeAsync<string>("localStorage.getItem", "rol");
        var nombre = await JS.InvokeAsync<string>("localStorage.getItem", "nombre");

        if (string.IsNullOrWhiteSpace(token))
        {
            Navigation.NavigateTo("/acceso-interno", forceLoad: true);
            return;
        }

        if (string.IsNullOrWhiteSpace(rol) || rol.Trim().ToLower() != "vendedor")
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        if (!string.IsNullOrWhiteSpace(nombre))
        {
            nombreUsuario = nombre;
        }
    }

    private void IrSolicitudes()
    {
        Navigation.NavigateTo("/vendedor/solicitudes");
    }

    private void IrInstalaciones()
    {
        Navigation.NavigateTo("/vendedor/instalaciones");
    }

    private void IrClientes()
    {
        Navigation.NavigateTo("/vendedor/clientes");
    }
}