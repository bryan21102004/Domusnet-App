@page "/admin/reportes"
@using DomusNet.Blazor.Models
@using DomusNet.Blazor.Services
@using DomusNet.Shared.DTOs
@using Microsoft.JSInterop
@inject ReportesService ReportesService
@inject AuthFrontendService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Reportes financieros</PageTitle>

<div class="reportes-page min-h-screen text-domus-text px-4 py-6">

    <div class="max-w-7xl mx-auto space-y-6">

        <!-- Encabezado -->
        <section class="hero-reportes">
            <div>
                <div class="hero-badge">
                    DomusNet · Finanzas
                </div>

                <h1 class="hero-title">
                    Reportes financieros
                </h1>

                <p class="hero-subtitle">
                    Generación, consulta, distribución de ingresos y descarga de reportes administrativos.
                </p>
            </div>

            <div class="hero-actions">
                <button class="btn-soft"
                        disabled="@cargandoTrabajadores"
                        @onclick="() => CargarTrabajadoresAutomaticamente(true)">
                    @(cargandoTrabajadores ? "Actualizando..." : "Actualizar trabajadores")
                </button>

                @if (detalle?.Resumen != null)
                {
                    <button class="btn-primary"
                            disabled="@cargandoPdf"
                            @onclick="DescargarPdf">
                        @(cargandoPdf ? "Generando PDF..." : "Descargar PDF")
                    </button>
                }
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="@ClaseMensaje">
                @mensaje
            </div>
        }

        <!-- Acciones principales -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-5">

            <!-- Generar reporte -->
            <div class="panel-card lg:col-span-2">
                <div class="panel-header">
                    <div>
                        <h2 class="panel-title">Generar reporte</h2>
                        <p class="panel-description">
                            Seleccioná el periodo que querés procesar para generar el reporte financiero.
                        </p>
                    </div>

                    <span class="status-pill success">
                        Disponible
                    </span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-5">
                    <div>
                        <label class="label-admin">Mes</label>
                        <input type="number"
                               min="1"
                               max="12"
                               class="input-admin"
                               @bind="generar.Mes" />
                    </div>

                    <div>
                        <label class="label-admin">Año</label>
                        <input type="number"
                               class="input-admin"
                               @bind="generar.Anio" />
                    </div>

                    <div>
                        <label class="label-admin">Quincena</label>
                        <select class="input-admin"
                                @bind="generar.Quincena">
                            <option value="">Mes completo</option>
                            <option value="Primera">Primera</option>
                            <option value="Segunda">Segunda</option>
                        </select>
                    </div>

                    <div class="flex items-end">
                        <button class="btn-success w-full"
                                disabled="@generandoReporte"
                                @onclick="GenerarReporte">
                            @(generandoReporte ? "Generando..." : "Generar reporte")
                        </button>
                    </div>
                </div>

                <div class="mt-4">
                    <label class="label-admin">Notas</label>
                    <textarea rows="3"
                              class="input-admin resize-none"
                              @bind="generar.Notas"
                              placeholder="Notas opcionales para el reporte"></textarea>
                </div>
            </div>

            <!-- Consultar reporte -->
            <div class="panel-card">
                <div class="panel-header">
                    <div>
                        <h2 class="panel-title">Consultar reporte</h2>
                        <p class="panel-description">
                            Buscá un reporte ya generado por su identificador.
                        </p>
                    </div>
                </div>

                <div class="mt-5">
                    <label class="label-admin">Id del reporte</label>

                    <div class="flex gap-2">
                        <input type="number"
                               class="input-admin"
                               @bind="idReporteConsulta" />

                        <button class="btn-soft px-5"
                                disabled="@consultandoReporte"
                                @onclick="ConsultarReporte">
                            @(consultandoReporte ? "..." : "Ver")
                        </button>
                    </div>
                </div>

                <div class="mini-info mt-5">
                    @if (detalle?.Resumen != null)
                    {
                        <p class="text-xs text-slate-400">Reporte cargado</p>
                        <p class="text-xl font-black text-white">
                            #@detalle.Resumen.IdIngresoMensual
                        </p>
                    }
                    else
                    {
                        <p class="text-xs text-slate-400">Estado</p>
                        <p class="text-sm font-semibold text-slate-200">
                            Sin reporte cargado
                        </p>
                    }
                </div>
            </div>
        </section>

        <!-- Configuración de distribución -->
        <details class="panel-card overflow-hidden" open>
            <summary class="summary-header">
                <div>
                    <h2 class="panel-title">Configuración de distribución</h2>
                    <p class="panel-description">
                        Los trabajadores se cargan automáticamente desde los usuarios registrados.
                    </p>
                </div>

                <div class="summary-totals">
                    <span>DomusNet @configuracion.PorcentajeDomusNet.ToString("N2")%</span>
                    <span>Trabajadores @TotalTrabajadores().ToString("N2")%</span>
                    <span class="@(DistribucionValida() ? "ok" : "bad")">
                        Total @TotalGeneral().ToString("N2")%
                    </span>
                </div>
            </summary>

            <div class="pt-5 border-t border-slate-800/80">

                <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
                    <div class="md:col-span-2">
                        <label class="label-admin">Nombre de configuración</label>
                        <input class="input-admin"
                               @bind="configuracion.Nombre" />
                    </div>

                    <div>
                        <label class="label-admin">% DomusNet</label>
                        <input type="number"
                               step="0.01"
                               class="input-admin"
                               @bind="configuracion.PorcentajeDomusNet" />
                    </div>

                    <div>
                        <label class="label-admin">% IVA</label>
                        <input type="number"
                               step="0.01"
                               class="input-admin"
                               @bind="configuracion.PorcentajeIVA" />
                    </div>

                    <div>
                        <label class="label-admin">% Cruz Roja</label>
                        <input type="number"
                               step="0.01"
                               class="input-admin"
                               @bind="configuracion.PorcentajeCruzRoja" />
                    </div>

                    <div>
                        <label class="label-admin">% 911</label>
                        <input type="number"
                               step="0.01"
                               class="input-admin"
                               @bind="configuracion.Porcentaje911" />
                    </div>
                </div>

                <!-- Métricas -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
                    <div class="metric-card">
                        <p class="metric-label">Trabajadores cargados</p>
                        <h3 class="metric-value">
                            @configuracion.Trabajadores.Count
                        </h3>
                    </div>

                    <div class="metric-card">
                        <p class="metric-label">Total trabajadores</p>
                        <h3 class="metric-value text-emerald-300">
                            @TotalTrabajadores().ToString("N2")%
                        </h3>
                    </div>

                    <div class="metric-card">
                        <p class="metric-label">Total general</p>
                        <h3 class="metric-value @(DistribucionValida() ? "text-cyan-300" : "text-red-300")">
                            @TotalGeneral().ToString("N2")%
                        </h3>
                    </div>
                </div>

                <!-- Trabajadores -->
                <div class="mt-6">
                    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-4">
                        <div>
                            <h3 class="section-title mb-1">
                                Distribución por trabajador
                            </h3>
                          
                        </div>

                        <button class="btn-soft"
                                disabled="@cargandoTrabajadores"
                                @onclick="() => CargarTrabajadoresAutomaticamente(true)">
                            @(cargandoTrabajadores ? "Cargando..." : "Recargar trabajadores")
                        </button>
                    </div>

                    <div class="table-shell">
                        <table class="w-full text-sm">
                            <thead>
                                <tr>
                                    <th class="text-left px-5 py-4">Trabajador</th>
                                    <th class="text-left px-5 py-4">Rol</th>
                                    <th class="text-right px-5 py-4">Porcentaje</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (!configuracion.Trabajadores.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="px-5 py-8 text-center text-slate-400">
                                            No hay trabajadores cargados.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var trabajador in configuracion.Trabajadores)
                                    {
                                        <tr>
                                            <td class="px-5 py-4">
                                                <div class="flex items-center gap-3">
                                                    <div class="worker-avatar">
                                                        @Iniciales(NombreTrabajador(trabajador.IdUsuario))
                                                    </div>

                                                    <div>
                                                        <p class="font-bold text-white">
                                                            @NombreTrabajador(trabajador.IdUsuario)
                                                        </p>
                                                        <p class="text-xs text-slate-400">
                                                            Usuario #@trabajador.IdUsuario
                                                        </p>
                                                    </div>
                                                </div>
                                            </td>

                                            <td class="px-5 py-4">
                                                <span class="role-pill">
                                                    @Texto(trabajador.TipoDistribucion, "Otro")
                                                </span>
                                            </td>

                                            <td class="px-5 py-4 text-right">
                                                <input type="number"
                                                       step="0.01"
                                                       class="input-percent"
                                                       @bind="trabajador.Porcentaje" />
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>

                            <tfoot>
                                <tr>
                                    <td class="px-5 py-4 font-bold" colspan="2">
                                        Total trabajadores
                                    </td>
                                    <td class="px-5 py-4 text-right font-black">
                                        @TotalTrabajadores().ToString("N2")%
                                    </td>
                                </tr>

                                <tr>
                                    <td class="px-5 py-4 font-bold" colspan="2">
                                        Total general
                                    </td>
                                    <td class="px-5 py-4 text-right font-black @(DistribucionValida() ? "text-emerald-300" : "text-red-300")">
                                        @TotalGeneral().ToString("N2")%
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row justify-end gap-3 mt-5">
                    <button class="btn-soft"
                            disabled="@cargandoTrabajadores"
                            @onclick="() => CargarTrabajadoresAutomaticamente(true)">
                        Actualizar trabajadores
                    </button>

                    <button class="btn-primary"
                            disabled="@guardandoConfiguracion"
                            @onclick="GuardarConfiguracion">
                        @(guardandoConfiguracion ? "Guardando..." : "Guardar configuración")
                    </button>
                </div>
            </div>
        </details>

        <!-- Reporte cargado -->
        @if (detalle?.Resumen != null)
        {
            <section class="panel-card">

                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-6">
                    <div>
                        <div class="hero-badge">
                            Reporte generado
                        </div>

                        <h2 class="text-2xl font-black text-white mt-2">
                            Reporte #@detalle.Resumen.IdIngresoMensual
                        </h2>

                        <p class="text-sm text-slate-400 mt-1">
                            @NombreMes(detalle.Resumen.Mes) @detalle.Resumen.Anio ·
                            @(string.IsNullOrWhiteSpace(detalle.Resumen.Quincena) ? "Mes completo" : detalle.Resumen.Quincena) ·
                            Registrado por @Texto(detalle.Resumen.RegistradoPor, "Sin usuario")
                        </p>
                    </div>

                    <button class="btn-primary"
                            disabled="@cargandoPdf"
                            @onclick="DescargarPdf">
                        @(cargandoPdf ? "Generando PDF..." : "Descargar PDF")
                    </button>
                </div>

                <!-- Resumen -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
                    <div class="metric-card">
                        <p class="metric-label">Total bruto</p>
                        <h3 class="metric-value">@Colon(detalle.Resumen.MontoTotalBruto)</h3>
                    </div>

                    <div class="metric-card">
                        <p class="metric-label">Total con rebajas</p>
                        <h3 class="metric-value">@Colon(detalle.Resumen.MontoTotalConRebajas)</h3>
                    </div>

                    <div class="metric-card">
                        <p class="metric-label">DomusNet</p>
                        <h3 class="metric-value text-cyan-300">@Colon(detalle.Resumen.MontoDomusNet)</h3>
                    </div>

                    <div class="metric-card">
                        <p class="metric-label">Trabajadores</p>
                        <h3 class="metric-value text-emerald-300">@Colon(detalle.Resumen.MontoTrabajadores)</h3>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

                    <!-- Totales por tipo -->
                    <div>
                        <h3 class="section-title">Totales por tipo</h3>

                        <div class="table-shell">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr>
                                        <th class="text-left px-5 py-4">Tipo</th>
                                        <th class="text-right px-5 py-4">Total asignado</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (!detalle.TotalesPorTipo.Any())
                                    {
                                        <tr>
                                            <td colspan="2" class="px-5 py-6 text-center text-slate-400">
                                                No hay datos.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var tipo in detalle.TotalesPorTipo)
                                        {
                                            <tr>
                                                <td class="px-5 py-4">@Texto(tipo.TipoDistribucion, "Otro")</td>
                                                <td class="px-5 py-4 text-right font-bold">@Colon(tipo.TotalAsignado)</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Rebajos -->
                    <div>
                        <h3 class="section-title">Rebajos aplicados</h3>

                        <div class="table-shell">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr>
                                        <th class="text-left px-5 py-4">Rebajo</th>
                                        <th class="text-right px-5 py-4">Porcentaje</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <tr>
                                        <td class="px-5 py-4">IVA</td>
                                        <td class="px-5 py-4 text-right">@detalle.Resumen.PorcentajeIVA.ToString("N2")%</td>
                                    </tr>

                                    <tr>
                                        <td class="px-5 py-4">Cruz Roja</td>
                                        <td class="px-5 py-4 text-right">@detalle.Resumen.PorcentajeCruzRoja.ToString("N2")%</td>
                                    </tr>

                                    <tr>
                                        <td class="px-5 py-4">911</td>
                                        <td class="px-5 py-4 text-right">@detalle.Resumen.Porcentaje911.ToString("N2")%</td>
                                    </tr>

                                    <tr>
                                        <td class="px-5 py-4 font-bold">Total rebajos</td>
                                        <td class="px-5 py-4 text-right font-black">
                                            @TotalRebajosReporte().ToString("N2")%
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Distribución generada -->
                <div class="mt-6">
                    <h3 class="section-title">Distribución generada</h3>

                    <div class="table-shell">
                        <table class="w-full text-sm">
                            <thead>
                                <tr>
                                    <th class="text-left px-5 py-4">Trabajador</th>
                                    <th class="text-left px-5 py-4">Tipo</th>
                                    <th class="text-right px-5 py-4">Porcentaje</th>
                                    <th class="text-right px-5 py-4">Monto</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in detalle.Distribuciones)
                                {
                                    <tr>
                                        <td class="px-5 py-4">
                                            <span class="font-bold text-white">@Texto(item.Trabajador, "Sin nombre")</span>
                                            <span class="text-xs text-slate-400 ml-1">#@item.IdUsuario</span>
                                        </td>

                                        <td class="px-5 py-4">
                                            <span class="role-pill">
                                                @Texto(item.TipoDistribucion, "Otro")
                                            </span>
                                        </td>

                                        <td class="px-5 py-4 text-right">
                                            @item.PorcentajeAplicado.ToString("N2")%
                                        </td>

                                        <td class="px-5 py-4 text-right font-black">
                                            @Colon(item.MontoAsignado)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(detalle.Resumen.Notas))
                {
                    <div class="notes-box mt-6">
                        <p class="text-xs text-slate-400 mb-1">Notas</p>
                        <p class="text-sm text-slate-100">
                            @detalle.Resumen.Notas
                        </p>
                    </div>
                }
            </section>
        }
    </div>
</div>

@code {
    private string? mensaje;
    private bool mensajeEsError;

    private bool guardandoConfiguracion;
    private bool generandoReporte;
    private bool consultandoReporte;
    private bool cargandoPdf;
    private bool cargandoTrabajadores;

    private int idUsuarioActual = 1;
    private int idReporteConsulta = 1;

    private List<TrabajadorUsuarioResponse> trabajadoresDisponibles = new();

    private string ClaseMensaje =>
        mensajeEsError
            ? "rounded-2xl border border-red-500/30 bg-red-500/10 px-5 py-4 text-red-200 text-sm"
            : "rounded-2xl border border-cyan-500/30 bg-cyan-500/10 px-5 py-4 text-cyan-200 text-sm";

    private GuardarConfiguracionDistribucionRequest configuracion = new()
    {
        Nombre = "Configuración base DomusNet",
        PorcentajeDomusNet = 70,
        PorcentajeIVA = 13,
        PorcentajeCruzRoja = 1,
        Porcentaje911 = 0.75m,
        Trabajadores = new()
    };

    private GenerarReporteIngresosRequest generar = new()
    {
        Mes = 6,
        Anio = 2026,
        Quincena = null,
        Notas = "Reporte mensual"
    };

    private DetalleReporteIngresoResponse? detalle;

    protected override async Task OnInitializedAsync()
    {
        var rol = await AuthService.ObtenerRolAsync();

        if (rol?.Trim().ToLower() != "administrador")
        {
            Navigation.NavigateTo("/");
            return;
        }

        var idUsuario = await AuthService.ObtenerUsuarioIdAsync();

        if (idUsuario > 0)
        {
            idUsuarioActual = idUsuario;
        }

        configuracion.IdCreadoPor = idUsuarioActual;
        generar.IdRegistradoPor = idUsuarioActual;

        await CargarTrabajadoresAutomaticamente(false);
    }

    private async Task CargarTrabajadoresAutomaticamente(bool mostrarMensaje = true)
    {
        cargandoTrabajadores = true;

        if (mostrarMensaje)
        {
            mensaje = null;
        }

        try
        {
            trabajadoresDisponibles = await ReportesService.ListarTrabajadoresAsync();

            configuracion.Trabajadores.Clear();

            if (!trabajadoresDisponibles.Any())
            {
                MostrarMensaje("No se encontraron trabajadores registrados.", true);
                return;
            }

            var porcentajeTrabajadores = 100 - configuracion.PorcentajeDomusNet;

            if (porcentajeTrabajadores < 0)
            {
                MostrarMensaje("El porcentaje de DomusNet no puede ser mayor a 100%.", true);
                return;
            }

            var porcentajePorTrabajador = Math.Round(
                porcentajeTrabajadores / trabajadoresDisponibles.Count,
                2
            );

            foreach (var trabajador in trabajadoresDisponibles)
            {
                configuracion.Trabajadores.Add(new TrabajadorDistribucionRequest
                {
                    IdUsuario = trabajador.IdUsuario,
                    TipoDistribucion = NormalizarRol(trabajador.Rol),
                    Porcentaje = porcentajePorTrabajador
                });
            }

            AjustarDiferenciaPorRedondeo();

            if (mostrarMensaje)
            {
                MostrarMensaje("Trabajadores actualizados correctamente.", false);
            }
        }
        catch
        {
            MostrarMensaje("No se pudieron cargar los trabajadores.", true);
        }
        finally
        {
            cargandoTrabajadores = false;
        }
    }

    private void AjustarDiferenciaPorRedondeo()
    {
        if (!configuracion.Trabajadores.Any())
        {
            return;
        }

        var porcentajeEsperado = 100 - configuracion.PorcentajeDomusNet;
        var diferencia = porcentajeEsperado - TotalTrabajadores();

        configuracion.Trabajadores[^1].Porcentaje += diferencia;
    }

    private decimal TotalTrabajadores()
    {
        return configuracion.Trabajadores.Sum(t => t.Porcentaje);
    }

    private decimal TotalGeneral()
    {
        return configuracion.PorcentajeDomusNet + TotalTrabajadores();
    }

    private bool DistribucionValida()
    {
        return Math.Abs(TotalGeneral() - 100) <= 0.01m;
    }

    private decimal TotalRebajosReporte()
    {
        if (detalle?.Resumen == null)
        {
            return 0;
        }

        return detalle.Resumen.PorcentajeIVA +
               detalle.Resumen.PorcentajeCruzRoja +
               detalle.Resumen.Porcentaje911;
    }

    private async Task GuardarConfiguracion()
    {
        mensaje = null;

        if (!configuracion.Trabajadores.Any())
        {
            MostrarMensaje("Primero cargá los trabajadores registrados.", true);
            return;
        }

        if (!DistribucionValida())
        {
            MostrarMensaje("La suma de DomusNet y trabajadores debe ser 100%.", true);
            return;
        }

        guardandoConfiguracion = true;

        try
        {
            configuracion.IdCreadoPor = idUsuarioActual;

            var resultado = await ReportesService.GuardarConfiguracionAsync(configuracion);

            MostrarMensaje(
                resultado?.Mensaje ?? "No se obtuvo respuesta del servidor.",
                resultado?.Resultado != 1
            );
        }
        finally
        {
            guardandoConfiguracion = false;
        }
    }

    private async Task GenerarReporte()
    {
        mensaje = null;
        generandoReporte = true;

        try
        {
            generar.IdRegistradoPor = idUsuarioActual;

            if (string.IsNullOrWhiteSpace(generar.Quincena))
            {
                generar.Quincena = null;
            }

            var resultado = await ReportesService.GenerarReporteAsync(generar);

            MostrarMensaje(
                resultado?.Mensaje ?? "No se obtuvo respuesta del servidor.",
                resultado?.Resultado != 1
            );

            if (resultado?.Resultado == 1)
            {
                idReporteConsulta = resultado.IdGenerado;
                await ConsultarReporte();
            }
        }
        finally
        {
            generandoReporte = false;
        }
    }

    private async Task ConsultarReporte()
    {
        mensaje = null;
        consultandoReporte = true;

        try
        {
            detalle = await ReportesService.ObtenerDetalleAsync(idReporteConsulta);

            if (detalle == null)
            {
                MostrarMensaje("No se encontró el reporte.", true);
            }
        }
        catch
        {
            MostrarMensaje("No se pudo consultar el reporte.", true);
        }
        finally
        {
            consultandoReporte = false;
        }
    }

    private async Task DescargarPdf()
    {
        mensaje = null;

        if (detalle?.Resumen == null)
        {
            MostrarMensaje("Primero consultá un reporte.", true);
            return;
        }

        cargandoPdf = true;

        try
        {
            var idReporte = detalle.Resumen.IdIngresoMensual;

            var pdf = await ReportesService.DescargarPdfAsync(idReporte);

            if (pdf == null)
            {
                MostrarMensaje("No se pudo generar el PDF.", true);
                return;
            }

            var base64 = Convert.ToBase64String(pdf);

            await JS.InvokeVoidAsync(
                "domusDownloadFile",
                $"reporte-ingresos-{idReporte}.pdf",
                "application/pdf",
                base64
            );

            MostrarMensaje("PDF generado correctamente.", false);
        }
        finally
        {
            cargandoPdf = false;
        }
    }

    private void MostrarMensaje(string texto, bool esError)
    {
        mensaje = texto;
        mensajeEsError = esError;
    }

    private string Colon(decimal monto)
    {
        return $"₡{monto:N2}";
    }

    private string Texto(string? valor, string reemplazo)
    {
        return string.IsNullOrWhiteSpace(valor)
            ? reemplazo
            : valor;
    }

    private string NombreMes(int mes)
    {
        return mes switch
        {
            1 => "Enero",
            2 => "Febrero",
            3 => "Marzo",
            4 => "Abril",
            5 => "Mayo",
            6 => "Junio",
            7 => "Julio",
            8 => "Agosto",
            9 => "Septiembre",
            10 => "Octubre",
            11 => "Noviembre",
            12 => "Diciembre",
            _ => $"Mes {mes}"
        };
    }

    private string NormalizarRol(string? rol)
    {
        return rol?.Trim().ToLower() switch
        {
            "administrador" => "Administrador",
            "vendedor" => "Vendedor",
            "tecnico" => "Tecnico",
            "técnico" => "Tecnico",
            _ => "Otro"
        };
    }

    private string NombreTrabajador(int idUsuario)
    {
        var trabajador = trabajadoresDisponibles
            .FirstOrDefault(t => t.IdUsuario == idUsuario);

        return trabajador == null
            ? $"Usuario #{idUsuario}"
            : trabajador.Nombre;
    }

    private string Iniciales(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
        {
            return "U";
        }

        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (partes.Length == 1)
        {
            return partes[0][0].ToString().ToUpper();
        }

        return $"{partes[0][0]}{partes[1][0]}".ToUpper();
    }
}

