@page "/acceso-interno"

<PageTitle>Acceso Interno — DomusNet</PageTitle>

<section class="min-h-[calc(100vh-4rem)] flex items-center justify-center px-4">
    <div class="w-full max-w-md animate-fade-in-up">

        <!-- Header -->
        <div class="text-center mb-8">
            <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-gradient-to-br from-cyan-500 to-emerald-500 flex items-center justify-center">
                <svg class="w-8 h-8 text-domus-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                </svg>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-domus-text mb-2">
                Acceso <span class="gradient-text">Interno</span>
            </h1>
            <p class="text-domus-text-secondary text-sm">
                Ingresa tus credenciales para acceder al panel de administración.
            </p>
        </div>

        <!-- Login Card -->
        <div class="domus-card">
            <form class="space-y-5">
                <div>
                    <label class="block text-sm font-medium text-domus-text mb-1.5">Usuario</label>
                    <input type="text" placeholder="Ingresa tu usuario"
                           class="w-full px-4 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text placeholder-domus-text-secondary/50 focus:outline-none focus:border-domus-cyan focus:ring-1 focus:ring-domus-cyan/30 transition-colors" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-domus-text mb-1.5">Contraseña</label>
                    <input type="password" placeholder="Ingresa tu contraseña"
                           class="w-full px-4 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text placeholder-domus-text-secondary/50 focus:outline-none focus:border-domus-cyan focus:ring-1 focus:ring-domus-cyan/30 transition-colors" />
                </div>
                <button type="submit" class="btn-primary-domus w-full justify-center py-3 text-base">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
                    </svg>
                    Iniciar Sesión
                </button>
            </form>
        </div>

    </div>
</section>
