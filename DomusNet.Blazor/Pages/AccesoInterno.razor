@page "/acceso-interno"
@using DomusNet.Blazor.Models
@using DomusNet.Blazor.Services
@using DomusNet.Blazor.Helpers
@inject AuthFrontendService AuthService
@inject NavigationManager Navigation

<PageTitle>Acceso Interno — DomusNet</PageTitle>

<section class="min-h-[calc(100vh-4rem)] flex items-center justify-center px-4">
    <div class="w-full max-w-md animate-fade-in-up">

   
        <div class="text-center mb-8">
            <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-gradient-to-br from-cyan-500 to-emerald-500 flex items-center justify-center">
                <svg class="w-8 h-8 text-domus-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                </svg>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-domus-text mb-2">
                Acceso <span class="gradient-text">Interno</span>
            </h1>
            <p class="text-domus-text-secondary text-sm">
                Ingresa tus credenciales para acceder al panel administrativo.
            </p>
        </div>

        <div class="domus-card">
           <form class="space-y-5" @onsubmit="IniciarSesionAsync" @onsubmit:preventDefault="true">
    <div>
        <label class="block text-sm font-medium text-domus-text mb-1.5">Correo</label>
        <input type="email"
               placeholder="Ingresa tu correo"
               @bind="login.Correo"
               class="w-full px-4 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text placeholder-domus-text-secondary/50 focus:outline-none focus:border-domus-cyan focus:ring-1 focus:ring-domus-cyan/30 transition-colors" />
    </div>

    <div>
        <label class="block text-sm font-medium text-domus-text mb-1.5">Contraseña</label>
        <input type="password"
               placeholder="Ingresa tu contraseña"
               @bind="login.Password"
               class="w-full px-4 py-3 rounded-lg bg-domus-white border border-domus-border text-domus-text placeholder-domus-text-secondary/50 focus:outline-none focus:border-domus-cyan focus:ring-1 focus:ring-domus-cyan/30 transition-colors" />
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="p-3 rounded-lg border border-red-500/40 bg-red-500/10 text-red-300 text-sm">
            @mensaje
        </div>
    }

    <button type="submit"
            disabled="@cargando"
            class="btn-primary-domus w-full justify-center py-3 text-base disabled:opacity-60 disabled:cursor-not-allowed">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
        </svg>

        @(cargando ? "Iniciando sesión..." : "Iniciar Sesión")
    </button>
</form>
        </div>

    </div>
</section>

@code{
private LoginRequest login = new();
private string mensaje = "";
private bool cargando = false;


private async Task IniciarSesionAsync()
{
    mensaje = string.Empty;

    if (string.IsNullOrWhiteSpace(login.Correo))
    {
        mensaje = "Debe ingresar su correo electrónico.";
        return;
    }

    var correoVal = ValidacionesFormularioUsuario.ValidarCorreo(login.Correo);
    if (!correoVal.Valido)
    {
        mensaje = correoVal.Mensaje;
        return;
    }

    var passwordTrim = login.Password?.Trim() ?? string.Empty;
    if (string.IsNullOrEmpty(passwordTrim))
    {
        mensaje = "Debe ingresar su contraseña.";
        return;
    }

    login.Correo   = login.Correo.Trim();
    login.Password = passwordTrim;
    cargando = true;
    try
        {
            var resultado = await AuthService.LoginAsync(login);

            if (resultado == null)
            {
                mensaje = "Credenciales inválidas.";
                return;
            }

            var rol = resultado.Rol.Trim().ToLower();

            if (rol == "administrador")
            {
                Navigation.NavigateTo("/admin", forceLoad: true );
            }
            else if (rol == "vendedor")
            {
                Navigation.NavigateTo("/vendedor", forceLoad: true );
            }
            else if (rol == "tecnico" || rol == "técnico")
            {
                Navigation.NavigateTo("/tecnico", forceLoad: true );
            }
            else
            {
                Navigation.NavigateTo("/", forceLoad: true );
            }
        }
        catch
        {
            mensaje = "No se pudo conectar con el servidor.";
        }
        finally
        {
            cargando = false;
        }
    }



}










