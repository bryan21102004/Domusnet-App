@page "/solicitar-paquete/{IdPaquete:int}"
@using DomusNet.Blazor.Models
@using DomusNet.Blazor.Services
@using DomusNet.Blazor.Helpers
@inject PaquetesFrontendService PaquetesService
@inject SolicitudesPublicasService SolicitudesService
@inject NavigationManager Navigation
@inject ToastService Toast

<PageTitle>Solicitar paquete — DomusNet</PageTitle>

<section class="min-h-[calc(100vh-4rem)] px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-5xl mx-auto">

        <div class="mb-8">
            <button class="px-5 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text hover:border-cyan-500/50 transition-colors"
                    @onclick="VolverPaquetes">
                Volver a paquetes
            </button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <div class="domus-card lg:col-span-1">
                <p class="text-sm text-domus-cyan-light font-semibold mb-2">
                    Paquete seleccionado
                </p>

                @if (cargandoPaquete)
                {
                    <p class="text-domus-text-secondary">
                        Cargando paquete...
                    </p>
                }
                else if (paquete == null)
                {
                    <p class="text-red-300">
                        No se encontró el paquete seleccionado.
                    </p>
                }
                else
                {
                    <h1 class="text-2xl font-bold text-domus-text mb-4">
                        @paquete.Nombre
                    </h1>

                    <p class="text-5xl font-extrabold gradient-text mb-6">
                        @paquete.Velocidad
                        <span class="text-base text-domus-text-secondary">Mbps</span>
                    </p>

                    <p class="text-3xl font-extrabold text-domus-cyan-light mb-6">
                        ₡@paquete.Precio.ToString("N0")
                        <span class="text-base text-domus-text-secondary">/mes</span>
                    </p>

                    <div class="space-y-3 text-domus-text-secondary">
                        <p>✓ Instalación residencial</p>
                        <p>✓ Soporte técnico incluido</p>
                        <p>✓ Servicio sujeto a cobertura</p>
                    </div>
                }
            </div>

            <!-- Formulario -->
            <div class="domus-card lg:col-span-2">
                <div class="mb-8">
                    <h2 class="text-2xl font-bold text-domus-text">
                        Solicitud de servicio
                    </h2>
                    <p class="text-domus-text-secondary mt-2">
                        Completá los datos para que DomusNet pueda contactarte.
                    </p>
                </div>

                <form class="space-y-5" @onsubmit="EnviarSolicitud" @onsubmit:preventDefault="true">

                    <div>
                        <label class="block text-sm font-medium text-domus-text mb-1.5">
                            Nombre completo
                        </label>
                        <input type="text"
                               @bind="solicitud.NombreCompleto"
                               @bind:event="oninput"
                               placeholder="Ingrese su nombre completo"
                               class="@ClaseInput(errNombre)" />
                        @if (!string.IsNullOrWhiteSpace(errNombre))
                        {
                            <p class="text-xs text-red-300 mt-1.5">@errNombre</p>
                        }
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-sm font-medium text-domus-text mb-1.5">
                                Teléfono
                            </label>
                            <input type="text"
                                   inputmode="numeric"
                                   maxlength="8"
                                   pattern="[0-9]{8}"
                                   @bind="solicitud.Telefono"
                                   @bind:event="oninput"
                                   onkeydown="return (event.key >= '0' && event.key <= '9') || ['Backspace','Delete','Tab','ArrowLeft','ArrowRight','Home','End'].includes(event.key)"
                                   onpaste="return false"
                                   placeholder="Ej: 88888888"
                                   class="@ClaseInput(errTelefono)" />
                            @if (!string.IsNullOrWhiteSpace(errTelefono))
                            {
                                <p class="text-xs text-red-300 mt-1.5">@errTelefono</p>
                            }
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-domus-text mb-1.5">
                                Correo
                            </label>
                            <input type="email"
                                   @bind="solicitud.Correo"
                                   @bind:event="oninput"
                                   placeholder="correo@gmail.com"
                                   class="@ClaseInput(errCorreo)" />
                            @if (!string.IsNullOrWhiteSpace(errCorreo))
                            {
                                <p class="text-xs text-red-300 mt-1.5">@errCorreo</p>
                            }
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-domus-text mb-1.5">
                            Dirección
                        </label>
                        <textarea @bind="solicitud.Direccion"
                                  @bind:event="oninput"
                                  placeholder="Ingrese la dirección donde se instalará el servicio"
                                  rows="3"
                                  class="@ClaseInput(errDireccion)"></textarea>
                        @if (!string.IsNullOrWhiteSpace(errDireccion))
                        {
                            <p class="text-xs text-red-300 mt-1.5">@errDireccion</p>
                        }
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-domus-text mb-1.5">
                            Comentario adicional
                        </label>
                        <textarea @bind="solicitud.Notas"
                                  placeholder="Ej: horario disponible, referencia de ubicación, consulta adicional..."
                                  rows="3"
                                  class="w-full px-4 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text placeholder-domus-text-secondary/50 focus:outline-none focus:border-domus-cyan focus:ring-1 focus:ring-domus-cyan/30 transition-colors"></textarea>
                    </div>

                    <button type="submit"
                            disabled="@enviando"
                            class="btn-primary-domus w-full justify-center py-3 text-base disabled:opacity-60 disabled:cursor-not-allowed">
                        @(enviando ? "Enviando solicitud..." : "Enviar solicitud")
                    </button>

                    <div class="relative flex items-center py-2">
                        <div class="flex-grow border-t border-domus-border"></div>
                        <span class="flex-shrink mx-4 text-xs text-domus-text-secondary">
                            o también podés solicitarlo por WhatsApp
                        </span>
                        <div class="flex-grow border-t border-domus-border"></div>
                    </div>

                    <a href="@WhatsAppUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg bg-green-500 hover:bg-green-600 text-white font-semibold transition-colors no-underline">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20.52 3.48A11.86 11.86 0 0 0 12.08 0C5.5 0 .15 5.35.15 11.93c0 2.1.55 4.15 1.59 5.96L0 24l6.25-1.64a11.9 11.9 0 0 0 5.83 1.49h.01c6.58 0 11.93-5.35 11.93-11.93 0-3.19-1.24-6.18-3.5-8.44ZM12.09 21.84h-.01a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-3.71.97.99-3.62-.23-.37a9.86 9.86 0 0 1-1.51-5.3c0-5.47 4.45-9.92 9.92-9.92 2.65 0 5.14 1.03 7.01 2.91a9.84 9.84 0 0 1 2.9 7.01c0 5.47-4.45 9.91-9.95 9.91Zm5.44-7.43c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.47-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35Z" />
                        </svg>
                        Solicitar por WhatsApp
                    </a>
                </form>
            </div>

        </div>
    </div>
</section>

@code {
    [Parameter]
    public int IdPaquete { get; set; }

    private PaqueteResponse? paquete;
    private SolicitudPaqueteRequest solicitud = new();

    private bool cargandoPaquete = true;
    private bool enviando = false;

    private string errNombre = string.Empty;
    private string errTelefono = string.Empty;
    private string errCorreo = string.Empty;
    private string errDireccion = string.Empty;

    private string mensaje = string.Empty;
    private string claseMensaje = string.Empty;

    private const string NumeroWhatsAppDomusNet = "50685744358";

    private string WhatsAppUrl
    {
        get
        {
            var mensajeWhatsApp = paquete == null
                ? "Hola, quiero solicitar información sobre los paquetes de DomusNet."
                : $"Hola, quiero solicitar información sobre el paquete {paquete.Nombre} de {paquete.Velocidad} Mbps con precio ₡{paquete.Precio:N0}.";

            return $"https://wa.me/{NumeroWhatsAppDomusNet}?text={Uri.EscapeDataString(mensajeWhatsApp)}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        solicitud.IdPaquete = IdPaquete;

        try
        {
            paquete = await PaquetesService.BuscarAsync(IdPaquete);

            if (paquete == null)
            {
                Toast.Error("No se encontró el paquete seleccionado.");
            }
        }
        catch
        {
            Toast.Error("No se pudo cargar la información del paquete.");
        }
        finally
        {
            cargandoPaquete = false;
        }
    }

    private bool ValidarFormulario()
    {
        errNombre = string.Empty;
        errTelefono = string.Empty;
        errCorreo = string.Empty;
        errDireccion = string.Empty;

        var nombre = ValidacionesFormularioUsuario.ValidarNombre(solicitud.NombreCompleto);
        var telefono = ValidacionesFormularioUsuario.ValidarTelefonoObligatorio(solicitud.Telefono);
        var correo = ValidacionesFormularioUsuario.ValidarCorreo(solicitud.Correo);
        var direccion = ValidacionesFormularioUsuario.ValidarDireccion(solicitud.Direccion);

        if (!nombre.Valido) errNombre = nombre.Mensaje;
        if (!telefono.Valido) errTelefono = telefono.Mensaje;
        if (!correo.Valido) errCorreo = correo.Mensaje;
        if (!direccion.Valido) errDireccion = direccion.Mensaje;

        return nombre.Valido && telefono.Valido && correo.Valido && direccion.Valido;
    }

    private async Task EnviarSolicitud()
    {
        mensaje = string.Empty;

        if (paquete == null)
        {
            Toast.Error("No se puede enviar la solicitud porque el paquete no existe.");
            return;
        }

        if (!ValidarFormulario())
            return;

        solicitud.NombreCompleto = solicitud.NombreCompleto.Trim();
        solicitud.Telefono = ValidacionesFormularioUsuario.NormalizarTelefono(solicitud.Telefono);
        solicitud.Correo = solicitud.Correo?.Trim();
        solicitud.Direccion = solicitud.Direccion.Trim();

        enviando = true;

        try
        {
            solicitud.IdPaquete = IdPaquete;

            var resultado = await SolicitudesService.CrearSolicitudAsync(solicitud);

            if (resultado == null)
            {
                Toast.Error("No se obtuvo respuesta del servidor.");
                return;
            }

            if (resultado.Resultado == 1 ||
                (resultado.Mensaje?.Contains("correctamente", StringComparison.OrdinalIgnoreCase) ?? false))
            {
                Toast.Success(resultado.Mensaje ?? "Solicitud enviada correctamente.");

                solicitud = new SolicitudPaqueteRequest
                {
                    IdPaquete = IdPaquete
                };
            }
            else
            {
                Toast.Error(resultado.Mensaje ?? "No se pudo enviar la solicitud.");
            }
        }
        catch
        {
            Toast.Error("No se pudo enviar la solicitud. Verifique que la API esté activa.");
        }
        finally
        {
            enviando = false;
        }
    }

    private void VolverPaquetes() => Navigation.NavigateTo("/paquetes");

    private void MostrarExito(string texto) => Toast.Success(texto);
    private void MostrarError(string texto) => Toast.Error(texto);

    private static string ClaseInput(string? error)
    {
        const string b = "w-full px-4 py-3 rounded-lg bg-domus-dark border text-domus-text placeholder-domus-text-secondary/50 focus:outline-none focus:ring-1 transition-colors";
        return string.IsNullOrWhiteSpace(error)
            ? $"{b} border-domus-border focus:border-domus-cyan focus:ring-domus-cyan/30"
            : $"{b} border-red-500/50 focus:border-red-400 focus:ring-red-400/20";
    }
}