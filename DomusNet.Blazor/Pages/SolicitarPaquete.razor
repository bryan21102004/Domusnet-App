@page "/solicitar-paquete/{IdPaquete:int}"
@using DomusNet.Blazor.Models
@using DomusNet.Blazor.Services
@inject PaquetesFrontendService PaquetesService
@inject SolicitudesPublicasService SolicitudesService
@inject NavigationManager Navigation

<PageTitle>Solicitar paquete — DomusNet</PageTitle>

<section class="min-h-[calc(100vh-4rem)] px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-5xl mx-auto">

        <div class="mb-8">
            <button class="px-5 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text hover:border-cyan-500/50 transition-colors"
                    @onclick="VolverPaquetes">
                Volver a paquetes
            </button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <!-- Resumen del paquete -->
            <div class="domus-card lg:col-span-1">
                <p class="text-sm text-domus-cyan-light font-semibold mb-2">
                    Paquete seleccionado
                </p>

                @if (cargandoPaquete)
                {
                    <p class="text-domus-text-secondary">
                        Cargando paquete...
                    </p>
                }
                else if (paquete == null)
                {
                    <p class="text-red-300">
                        No se encontró el paquete seleccionado.
                    </p>
                }
                else
                {
                    <h1 class="text-2xl font-bold text-domus-text mb-4">
                        @paquete.Nombre
                    </h1>

                    <p class="text-5xl font-extrabold gradient-text mb-6">
                        @paquete.Velocidad
                        <span class="text-base text-domus-text-secondary">Mbps</span>
                    </p>

                    <p class="text-3xl font-extrabold text-domus-cyan-light mb-6">
                        ₡@paquete.Precio.ToString("N0")
                        <span class="text-base text-domus-text-secondary">/mes</span>
                    </p>

                    <div class="space-y-3 text-domus-text-secondary">
                        <p>✓ Instalación residencial</p>
                        <p>✓ Soporte técnico incluido</p>
                        <p>✓ Servicio sujeto a cobertura</p>
                    </div>
                }
            </div>

            <!-- Formulario -->
            <div class="domus-card lg:col-span-2">
                <div class="mb-8">
                    <h2 class="text-2xl font-bold text-domus-text">
                        Solicitud de servicio
                    </h2>
                    <p class="text-domus-text-secondary mt-2">
                        Completá los datos para que DomusNet pueda contactarte.
                    </p>
                </div>

                <form class="space-y-5" @onsubmit="EnviarSolicitud" @onsubmit:preventDefault="true">

                    <div>
                        <label class="block text-sm font-medium text-domus-text mb-1.5">
                            Nombre completo
                        </label>
                        <input type="text"
                               @bind="solicitud.NombreCompleto"
                               placeholder="Ingrese su nombre completo"
                               class="w-full px-4 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text placeholder-domus-text-secondary/50 focus:outline-none focus:border-domus-cyan focus:ring-1 focus:ring-domus-cyan/30 transition-colors" />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-sm font-medium text-domus-text mb-1.5">
                                Teléfono
                            </label>
                            <input type="text"
                                   @bind="solicitud.Telefono"
                                   placeholder="Ej: 88888888"
                                   class="w-full px-4 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text placeholder-domus-text-secondary/50 focus:outline-none focus:border-domus-cyan focus:ring-1 focus:ring-domus-cyan/30 transition-colors" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-domus-text mb-1.5">
                                Correo
                            </label>
                            <input type="email"
                                   @bind="solicitud.Correo"
                                   placeholder="correo@gmail.com"
                                   class="w-full px-4 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text placeholder-domus-text-secondary/50 focus:outline-none focus:border-domus-cyan focus:ring-1 focus:ring-domus-cyan/30 transition-colors" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-domus-text mb-1.5">
                            Dirección
                        </label>
                        <textarea @bind="solicitud.Direccion"
                                  placeholder="Ingrese la dirección donde se instalará el servicio"
                                  rows="3"
                                  class="w-full px-4 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text placeholder-domus-text-secondary/50 focus:outline-none focus:border-domus-cyan focus:ring-1 focus:ring-domus-cyan/30 transition-colors"></textarea>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-domus-text mb-1.5">
                            Comentario adicional
                        </label>
                        <textarea @bind="solicitud.Notas"
                                  placeholder="Ej: horario disponible, referencia de ubicación, consulta adicional..."
                                  rows="3"
                                  class="w-full px-4 py-3 rounded-lg bg-domus-dark border border-domus-border text-domus-text placeholder-domus-text-secondary/50 focus:outline-none focus:border-domus-cyan focus:ring-1 focus:ring-domus-cyan/30 transition-colors"></textarea>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(mensaje))
                    {
                        <div class="@claseMensaje">
                            @mensaje
                        </div>
                    }

                    <button type="submit"
                            disabled="@enviando"
                            class="btn-primary-domus w-full justify-center py-3 text-base disabled:opacity-60 disabled:cursor-not-allowed">
                        @(enviando ? "Enviando solicitud..." : "Enviar solicitud")
                    </button>
                </form>
            </div>

        </div>
    </div>
</section>

@code {
    [Parameter]
    public int IdPaquete { get; set; }

    private PaqueteResponse? paquete;
    private SolicitudPaqueteRequest solicitud = new();

    private bool cargandoPaquete = true;
    private bool enviando = false;

    private string mensaje = string.Empty;
    private string claseMensaje = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        solicitud.IdPaquete = IdPaquete;

        try
        {
            paquete = await PaquetesService.BuscarAsync(IdPaquete);
        }
        catch
        {
            mensaje = "No se pudo cargar la información del paquete.";
            claseMensaje = "p-4 rounded-lg border border-red-500/40 bg-red-500/10 text-red-300";
        }
        finally
        {
            cargandoPaquete = false;
        }
    }

    private async Task EnviarSolicitud()
    {
        mensaje = string.Empty;

        if (paquete == null)
        {
            MostrarError("No se puede enviar la solicitud porque el paquete no existe.");
            return;
        }

        if (string.IsNullOrWhiteSpace(solicitud.NombreCompleto) ||
            string.IsNullOrWhiteSpace(solicitud.Telefono) ||
            string.IsNullOrWhiteSpace(solicitud.Direccion))
        {
            MostrarError("Debe ingresar nombre, teléfono y dirección.");
            return;
        }

        enviando = true;

        try
        {
            solicitud.IdPaquete = IdPaquete;

            var resultado = await SolicitudesService.CrearSolicitudAsync(solicitud);

            if (resultado == null)
            {
                MostrarError("No se obtuvo respuesta del servidor.");
                return;
            }

            if (resultado.Resultado == 1)
            {
                MostrarExito("Solicitud enviada correctamente. DomusNet se pondrá en contacto contigo.");

                solicitud = new SolicitudPaqueteRequest
                {
                    IdPaquete = IdPaquete
                };
            }
            else
            {
                MostrarError(resultado.Mensaje);
            }
        }
        catch
        {
            MostrarError("No se pudo enviar la solicitud. Verifique que la API esté activa.");
        }
        finally
        {
            enviando = false;
        }
    }

    private void VolverPaquetes()
    {
        Navigation.NavigateTo("/paquetes");
    }

    private void MostrarExito(string texto)
    {
        mensaje = texto;
        claseMensaje = "p-4 rounded-lg border border-emerald-500/40 bg-emerald-500/10 text-emerald-300";
    }

    private void MostrarError(string texto)
    {
        mensaje = texto;
        claseMensaje = "p-4 rounded-lg border border-red-500/40 bg-red-500/10 text-red-300";
    }
}