@using Microsoft.JSInterop
@using DomusNet.Blazor.Services
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AuthFrontendService AuthService

<nav class="glass-nav fixed top-0 left-0 right-0 z-50 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">


<a href="@LogoHref" class="flex items-center gap-2 group no-underline overflow-visible">
    <img src="images/logo.png"
         alt="DomusNet Logo"
         class="h-16 w-auto max-w-[180px] object-contain transition-transform duration-300 group-hover:scale-105" />
          <span class="text-2xl font-extrabold text-domus-text tracking-tight group-hover:text-domus-cyan transition-colors duration-300">
        Domus<span class="text-domus-cyan">Net Costa Rica</span>
    </span>
</a>

            <!-- Desktop Navigation -->
            <div class="hidden md:flex items-center gap-3">

                @if (estaLogueado)
                {
                    <div class="flex items-center gap-3">
                        <div class="text-right mr-2">
                            <p class="text-sm font-semibold text-domus-text">
                                @nombreUsuario
                            </p>
                            <p class="text-xs text-domus-text-secondary">
                                @rolUsuario
